# ---- Ollama (AI explanation) ----
# For local dev: run `ollama serve` (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# For Ollama Cloud: get a key at https://ollama.ai/cloud
OLLAMA_API_KEY=

# Alchemy API key for Base mainnet RPC — https://dashboard.alchemy.com/
ALCHEMY_API_KEY=...

# Your wallet address that receives USDC payments
PAYMENT_WALLET_ADDRESS=0x...

# Neynar API key for resolving addresses ↔ Farcaster FIDs — https://neynar.com/
NEYNAR_API_KEY=...

# Alchemy webhook signing key (from Notify dashboard → your webhook → Signing Key)
# Used to verify that incoming webhooks are genuinely from Alchemy.
ALCHEMY_WEBHOOK_SIGNING_KEY=...

# ---- Deployment ----

# Your Vercel deployment URL (no trailing slash)
# e.g. https://wtfjusthappened.vercel.app
SNAP_PUBLIC_BASE_URL=

# ---- Turso (production persistence) ----
# Leave blank for local dev — an in-memory store is used automatically.
# Get these at https://turso.tech after running: turso db create wtfjusthappened
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Local dev only ----
# Skips JFS signature verification so you can test without a real Farcaster wallet.
SKIP_JFS_VERIFICATION=1
